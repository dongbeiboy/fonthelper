<Page
    x:Class="TOfont.WinUI.Tools.SerialPortTool.SerialPortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#EDEDED" />
                    <SolidColorBrush x:Key="TerminalTitleBarBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="TerminalPromptBrush" Color="#0067C0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="TerminalTitleBarBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="TerminalPromptBrush" Color="#00C8FF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 左侧：串口配置（Fluent 卡片） -->
        <!-- 隐藏垂直滚动条：内容固定几项，不需要滚动条占位 -->
        <ScrollViewer Grid.Column="0" Padding="16"
            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="串口配置" FontWeight="SemiBold" FontSize="16" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="PortCombo" Header="端口" Width="150" DropDownOpened="OnPortDropDown" />
                        <Button Content="刷新" Click="OnRefreshPorts" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>

                <ComboBox x:Name="BaudCombo" Header="波特率">
                    <ComboBoxItem>9600</ComboBoxItem>
                    <ComboBoxItem>19200</ComboBoxItem>
                    <ComboBoxItem>38400</ComboBoxItem>
                    <ComboBoxItem>57600</ComboBoxItem>
                    <ComboBoxItem>115200</ComboBoxItem>
                    <ComboBoxItem>230400</ComboBoxItem>
                    <ComboBoxItem>460800</ComboBoxItem>
                    <ComboBoxItem>921600</ComboBoxItem>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ComboBox x:Name="DataBitsCombo" Header="数据位" Width="110">
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="StopBitsCombo" Header="停止位" Width="110">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>1.5</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <ComboBox x:Name="ParityCombo" Header="校验位">
                    <ComboBoxItem>无</ComboBoxItem>
                    <ComboBoxItem>奇校验</ComboBoxItem>
                    <ComboBoxItem>偶校验</ComboBoxItem>
                </ComboBox>

                <Button x:Name="OpenBtn" Content="打开串口" Click="OnTogglePort"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" />

                <TextBlock x:Name="PortStatus" Text="未连接" FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 右侧：调试助手 / Shell 终端（TabView 自带标签条分隔线） -->
        <TabView x:Name="ModeTabView" Grid.Column="1" Grid.Row="0" Margin="12,12,12,8"
            IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            SelectionChanged="OnModeTabChanged">

            <!-- Tab 1: 调试助手 -->
            <TabViewItem Header="调试助手">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 接收区 -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <TextBlock Text="接收区" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="ReceiveModeCombo" Header="模式" SelectedIndex="0" Width="120"
                                SelectionChanged="OnReceiveModeChanged">
                                <ComboBoxItem>HEX</ComboBoxItem>
                                <ComboBoxItem>文本</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="ReceiveCodingCombo" Header="编码" SelectedIndex="0" Width="110">
                                <ComboBoxItem>GBK</ComboBoxItem>
                                <ComboBoxItem>UTF-8</ComboBoxItem>
                                <ComboBoxItem>ASCII</ComboBoxItem>
                                <ComboBoxItem>GB2312</ComboBoxItem>
                                <ComboBoxItem>UTF-16LE</ComboBoxItem>
                                <ComboBoxItem>UTF-16BE</ComboBoxItem>
                                <ComboBoxItem>Big5</ComboBoxItem>
                            </ComboBox>
                            <Button Content="清空" Click="OnClearReceive" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="ReceiveBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                            TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <!-- 分隔 -->
                    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefault}" Margin="0,8" />

                    <!-- 发送区 -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <TextBlock Text="发送区" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="SendModeCombo" Header="模式" SelectedIndex="0" Width="120"
                                SelectionChanged="OnSendModeChanged">
                                <ComboBoxItem>HEX</ComboBoxItem>
                                <ComboBoxItem>文本</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="SendCodingCombo" Header="编码" SelectedIndex="0" Width="110">
                                <ComboBoxItem>GBK</ComboBoxItem>
                                <ComboBoxItem>UTF-8</ComboBoxItem>
                                <ComboBoxItem>ASCII</ComboBoxItem>
                                <ComboBoxItem>GB2312</ComboBoxItem>
                                <ComboBoxItem>UTF-16LE</ComboBoxItem>
                                <ComboBoxItem>UTF-16BE</ComboBoxItem>
                                <ComboBoxItem>Big5</ComboBoxItem>
                            </ComboBox>
                            <Button Content="清空" Click="OnClearSend" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="SendBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                            FontFamily="Consolas" FontSize="12" PlaceholderText="输入要发送的内容..."
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button Grid.Row="2" Content="发送" Click="OnSend" HorizontalAlignment="Stretch"
                            Margin="0,6,0,0" />
                    </Grid>
                </Grid>
            </TabViewItem>

            <!-- Tab 2: Shell 终端（圆角终端：标题栏 + 输出区 + 输入行 + 状态栏） -->
            <TabViewItem Header="Shell 终端">
                <Border CornerRadius="8" Background="{ThemeResource TerminalBackgroundBrush}"
                    BorderBrush="{ThemeResource TerminalTitleBarBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                    <!-- 终端标题栏：macOS 三圆点 + 标题 + 清空 -->
                    <Grid Grid.Row="0" Background="{ThemeResource TerminalTitleBarBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="#FF5F56" />
                            <Ellipse Width="12" Height="12" Fill="#FFBD2E" />
                            <Ellipse Width="12" Height="12" Fill="#27C93F" />
                            <TextBlock Text="Shell" FontSize="12" FontWeight="SemiBold"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                            <DropDownButton Content="信号" Padding="8,2" FontSize="12">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Ctrl+C  (中断 / 0x03)" Click="OnShellSendCtrlC" />
                                        <MenuFlyoutItem Text="Ctrl+D  (EOF / 0x04)" Click="OnShellSendCtrlD" />
                                        <MenuFlyoutItem Text="Ctrl+Z  (挂起 / 0x1A)" Click="OnShellSendCtrlZ" />
                                        <MenuFlyoutItem Text="发送 Enter (\r)" Click="OnShellSendEnter" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="清空屏幕" Click="OnClearShell" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Content="Ctrl+C" Click="OnShellSendCtrlC"
                                Padding="8,2" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 终端输出区：满铺，无边框 -->
                    <TextBox x:Name="ShellOutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                        TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14"
                        Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0"
                        Padding="12,8"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                    <!-- 终端输入行：提示符 + 输入框（可展开多行）+ 发送/展开按钮 -->
                    <Grid Grid.Row="2" Background="{ThemeResource TerminalTitleBarBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="ShellInputBox"
                                PlaceholderText="输入命令，Enter 发送（↑↓ 历史）"
                                FontFamily="Consolas" FontSize="14"
                                Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0"
                                VerticalContentAlignment="Center" Height="40"
                                Padding="26,12,8,12"
                                KeyDown="OnShellInputKeyDown" TextChanged="OnShellInputChanged" />
                            <TextBlock Text="&gt;" FontFamily="Consolas" FontSize="14"
                                Foreground="{ThemeResource TerminalPromptBrush}" VerticalAlignment="Center"
                                Margin="8,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            Margin="0,0,8,0" VerticalAlignment="Bottom">
                            <Button x:Name="ShellSendBtn" Content="发送" Click="OnShellSend"
                                Padding="10,4" FontSize="12" VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <Button x:Name="ShellExpandBtn" Click="OnShellToggleExpand"
                                Padding="8,4" FontSize="12" VerticalAlignment="Center">
                                <FontIcon x:Name="ShellExpandGlyph" Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 终端状态栏：输入模式 / 编码 -->
                    <Grid Grid.Row="3" Background="{ThemeResource TerminalTitleBarBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="模式" FontSize="11" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="ShellModeCombo" SelectedIndex="0" Width="110"
                                    SelectionChanged="OnShellModeChanged">
                                    <ComboBoxItem>仿真终端</ComboBoxItem>
                                    <ComboBoxItem>透传模式</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="编码" FontSize="11" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="ShellCodingCombo" SelectedIndex="0" Width="110">
                                    <ComboBoxItem>GBK</ComboBoxItem>
                                    <ComboBoxItem>UTF-8</ComboBoxItem>
                                    <ComboBoxItem>ASCII</ComboBoxItem>
                                    <ComboBoxItem>GB2312</ComboBoxItem>
                                    <ComboBoxItem>UTF-16LE</ComboBoxItem>
                                    <ComboBoxItem>UTF-16BE</ComboBoxItem>
                                    <ComboBoxItem>Big5</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                </Border>
            </TabViewItem>
        </TabView>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
            Background="{ThemeResource CardBackgroundFillColorSecondary}"
            Padding="8,4" BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefault}">
            <TextBlock x:Name="StatusBar" Text="就绪"
                FontSize="11" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>
</Page>
