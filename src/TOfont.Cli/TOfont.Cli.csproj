<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 字模提取依赖 GDI+（System.Drawing），CLI 仅支持 Windows。
         net9.0-windows TFM 自动生成 [assembly: SupportedOSPlatform("windows")]，
         消除 CA1416 警告。 -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TOfont.Core\TOfont.Core.csproj" />
  </ItemGroup>

</Project>
