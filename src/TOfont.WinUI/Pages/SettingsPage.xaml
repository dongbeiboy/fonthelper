<Page
    x:Class="TOfont.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Sidebar" Background="{ThemeResource CardBackgroundFillColorDefault}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>

            <ListView x:Name="NavList" SelectionChanged="OnNavSelectionChanged"
                SelectionMode="Single" Padding="0" Margin="0,3,0,0">
                <ListViewItem x:Name="NavSettings" Tag="settings" IsSelected="True"
                    Padding="16,10">
                    <TextBlock Text="取模设置" FontSize="14" />
                </ListViewItem>
                <ListViewItem x:Name="NavCli" Tag="cli"
                    Padding="16,10">
                    <TextBlock Text="CLI 服务" FontSize="14" />
                </ListViewItem>
                <ListViewItem x:Name="NavAbout" Tag="about"
                    Padding="16,10">
                    <TextBlock Text="关于" FontSize="14" />
                </ListViewItem>
            </ListView>
        </Grid>

        <Border Grid.Column="1"
            Background="{ThemeResource DividerStrokeColorDefault}" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="SettingsPanel" Spacing="16" Padding="40,24" Visibility="Visible">
                    <ComboBox x:Name="ScanModeCombo" Header="扫描模式"
                        SelectedIndex="0" SelectionChanged="OnSettingChanged">
                        <ComboBoxItem>逐行</ComboBoxItem>
                        <ComboBoxItem>逐列</ComboBoxItem>
                        <ComboBoxItem>逐行进位</ComboBoxItem>
                        <ComboBoxItem>逐列进位</ComboBoxItem>
                    </ComboBox>

                    <CheckBox x:Name="MsbFirstChk" Content="高位在前"
                        IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    <CheckBox x:Name="LitIs1Chk" Content="阳码 (点亮为1)"
                        IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    <CheckBox x:Name="UseHexChk" Content="16进制输出"
                        IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                    <Border Height="1" Margin="0,8,0,0"
                        Background="{ThemeResource DividerStrokeColorDefault}" />

                    <TextBlock Text="串口助手" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <CheckBox x:Name="AutoScrollChk" Content="Shell 终端自动滚动"
                        IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </StackPanel>

                <!-- CLI 服务子页面 -->
                <StackPanel x:Name="CliPanel" Spacing="16" Padding="40,24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CLI 服务" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="通过本地 HTTP 接口让 agent 工具通过网络使用串口助手。仅监听本机 127.0.0.1，不对外网开放。" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch x:Name="CliToggle" Header="启用"
                            OffContent="关闭" OnContent="运行中"
                            Toggled="OnCliToggled" />
                        <NumberBox x:Name="CliPortBox" Header="端口" Minimum="1024" Maximum="65535"
                            Value="8765" SpinButtonPlacementMode="Compact" Width="140"
                            ValueChanged="OnCliPortChanged" />
                    </StackPanel>

                    <TextBlock x:Name="CliStatusText" FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="未运行" />

                    <TextBlock x:Name="CliErrorText" FontSize="12" TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="Collapsed" />

                    <Border Height="1" Margin="0,8,0,0"
                        Background="{ThemeResource DividerStrokeColorDefault}" />

                    <TextBlock Text="接口说明" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="GET" Grid.Row="0" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="/api/health" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="健康检查" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="GET" Grid.Row="1" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="/api/ports" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="枚举串口列表" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="GET" Grid.Row="2" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="/api/status" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="当前串口连接状态" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="POST" Grid.Row="3" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="/api/open" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="打开串口 {port, baud, dataBits, stopBits, parity}" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="POST" Grid.Row="4" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="/api/close" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="关闭串口" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="POST" Grid.Row="5" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="/api/send" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="发送 {data, mode: hex|text, encoding: gbk|utf-8}" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="GET" Grid.Row="6" FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="/api/read?format=hex" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="读取并清空接收数据 (format: hex|text)" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Border Height="1" Margin="0,8,0,0"
                        Background="{ThemeResource DividerStrokeColorDefault}" />

                    <TextBlock Text="调用示例 (PowerShell)" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="# 打开串口 COM3 @ 115200&#x0a;curl -X POST http://127.0.0.1:8765/api/open -H &quot;Content-Type: application/json&quot; -d '{&quot;port&quot;:&quot;COM3&quot;,&quot;baud&quot;:115200,&quot;dataBits&quot;:8,&quot;stopBits&quot;:&quot;1&quot;,&quot;parity&quot;:&quot;None&quot;}'&#x0a;&#x0a;# 发送 HEX&#x0a;curl -X POST http://127.0.0.1:8765/api/send -H &quot;Content-Type: application/json&quot; -d '{&quot;data&quot;:&quot;AA 55 01 FF&quot;,&quot;mode&quot;:&quot;hex&quot;}'&#x0a;&#x0a;# 读取接收数据&#x0a;curl &quot;http://127.0.0.1:8765/api/read?format=hex&quot;" />
                </StackPanel>

                <StackPanel x:Name="AboutPanel" Spacing="16" Padding="40,24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOfont" FontSize="28" FontWeight="Bold" />
                        <TextBlock x:Name="VersionText" FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="嵌入式点阵字模提取工具，支持 OLED / LCD 屏幕字库生成。"
                        FontSize="14" TextWrapping="Wrap" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="功能特性" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock FontSize="13"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run Text="• " /><Run Text="文字取模 — 输入文字，选择字体，生成点阵数据" /><LineBreak />
                            <Run Text="• " /><Run Text="图片取模 — 加载图片，裁剪缩放后二值化取模" /><LineBreak />
                            <Run Text="• " /><Run Text="字体库 — 从 PTL 字符列表批量生成完整字库" /><LineBreak />
                            <Run Text="• " /><Run Text="字库导入 — 导入已有二进制字库进行查看和再导出" /><LineBreak />
                            <Run Text="• " /><Run Text="4 种扫描模式，高位/低位在前，阴码/阳码切换" /><LineBreak />
                            <Run Text="• " /><Run Text="输出 C51 / ANSI C 格式字节数组" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="仓库地址" FontSize="16" FontWeight="SemiBold" />
                        <HyperlinkButton NavigateUri="https://github.com/dongbeiboy/fonthelper"
                            Content="github.com/dongbeiboy/fonthelper"
                            FontSize="13" Padding="0" />
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CheckUpdateBtn" Content="检查更新" Click="OnCheckUpdate" />
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,16,0,0">
                        <TextBlock FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="© 2026 dongbeiboy" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
