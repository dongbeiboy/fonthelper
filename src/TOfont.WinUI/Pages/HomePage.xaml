<Page
    x:Class="TOfont.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel Spacing="16">
            <TextBlock Text="工具箱" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="选择一个工具开始" FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <GridView x:Name="ToolGrid" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnToolClick" Margin="0,12,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="160" Height="120"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="36" />
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </Grid>
</Page>
