<Page
    x:Class="TOfont.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,40,48,48">
        <ScrollViewer>
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="工具箱" FontSize="40" FontWeight="Bold" />
                    <TextBlock Text="选择一个工具开始工作" FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <GridView x:Name="ToolGrid" SelectionMode="None" IsItemClickEnabled="True"
                    ItemClick="OnToolClick">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,16,16" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" Height="140" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                BorderThickness="1">
                                <Grid.Resources>
                                    <Style TargetType="Grid">
                                        <Setter Property="CornerRadius" Value="10" />
                                    </Style>
                                </Grid.Resources>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Spacing="10" Margin="20,0,0,0">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="34" />
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,16,0" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
