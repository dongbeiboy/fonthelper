<Window
    x:Class="TOfont.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TOfont">

    <Grid>
        <controls:NavigationView x:Name="NavView" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" SelectionChanged="OnNavSelectionChanged"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="200"
            Margin="0,48,0,0">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="主页" Tag="home">
                    <controls:NavigationViewItem.Icon>
                        <controls:FontIcon Glyph="&#xE80F;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator />
                <!-- 工具菜单项由 ToolCatalog 在代码中动态生成，见 MainWindow.xaml.cs -->
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="设置" Tag="settings">
                    <controls:NavigationViewItem.Icon>
                        <controls:FontIcon Glyph="&#xE713;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>
            <controls:Frame x:Name="ContentFrame" />
        </controls:NavigationView>

        <!-- Win11 风格标题区：左侧 App 图标 + 名称，右侧留白 -->
        <Grid x:Name="TitleBarArea" Height="48" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="PaneToggleBtn" Click="OnTogglePane"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    ToolTipService.ToolTip="折叠 / 展开导航">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
                <Border Width="28" Height="28" CornerRadius="7"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Text="TOfont" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
